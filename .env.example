# ─────────────────────────────────────────────────────────────
#  TerraTrace AI — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit the actual .env file to source control.
# ─────────────────────────────────────────────────────────────

# ── Copernicus / Sentinel Hub ─────────────────────────────────
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq LLM ─────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Hugging Face ──────────────────────────────────────────────
HF_TOKEN=your_hugging_face_token_here

# ── PostgreSQL + PostGIS ──────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=terratrace
POSTGRES_USER=terratrace
POSTGRES_PASSWORD=terratrace_dev_password

# Assembled connection string (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://terratrace:terratrace_dev_password@localhost:5432/terratrace

# ── App ───────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
